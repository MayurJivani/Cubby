[Unit]
Description=cubby (end-to-end encrypted drop box)
After=network-online.target

[Service]
WorkingDirectory=/opt/apps/Cubby
# Optional overrides only; nothing here is secret. (CUBBY_PIN, CUBBY_ADMIN_PROOF)
EnvironmentFile=-/etc/apps/cubby.env
Environment=NODE_ENV=production PORT=4747 CUBBY_DIR=/run/cubby CUBBY_TRUST_PROXY=1
ExecStart=/usr/bin/node bin/cubby.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
MemoryMax=768M
# Items live in RAM under /run/cubby (up to CUBBY_MB, 512 by default, charged to this unit)
# and go when the unit stops, by design. Hence more than the usual 512M.
RuntimeDirectory=cubby
# --- least privilege: a throwaway user per start, no capabilities, read-only code ---
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
NoNewPrivileges=yes
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# AF_NETLINK: os.networkInterfaces() (getifaddrs) needs it.
RestrictAddressFamilies=AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# A blocked call fails with EPERM instead of killing the process.
SystemCallErrorNumber=EPERM
UMask=0077
# No MemoryDenyWriteExecute: V8's JIT needs writable+executable pages.

[Install]
WantedBy=multi-user.target
