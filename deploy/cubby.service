[Unit]
Description=Cubby — end-to-end encrypted drop box
After=network.target

[Service]
ExecStart=/usr/bin/node /opt/apps/Cubby/bin/cubby.js
WorkingDirectory=/opt/apps/Cubby
Environment=PORT=4747
Environment=CUBBY_DIR=/var/lib/cubby
Environment=CUBBY_HOURS=24
Environment=CUBBY_MB=2048
# Behind Caddy every request arrives from 127.0.0.1; without this the rate
# limiter would put the whole internet in one bucket.
Environment=CUBBY_TRUST_PROXY=1
Restart=always
RestartSec=2

# The service holds other people's ciphertext and nothing else. Give it a
# throwaway user, one writable directory, and no view of the rest of the box.
DynamicUser=yes
StateDirectory=cubby
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=512M

[Install]
WantedBy=multi-user.target
